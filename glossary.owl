        dc:description  "chemical compound, InChIKey DOQPXTMNIUCOSY-UHFFFAOYSA-N, CAS registry number 152-11-4"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000003>
        rdf:type        owl:Class ;
        rdfs:label      "Benchmark Dose Modeling"@en-US ;
        rdfs:seeAlso    <https://vhp4safety.github.io/glossary#VHP0000002> ;
        ncit:C42610     "BMD"@en-US ;
        dc:description  "An approach to determine the toxicological limit values for human health, such as the acceptable daily intake (ADI), of all chemical substances (e.g., food) regardless of type or origin. BMD modeling (possibly in combination with PBK modeling) analyzes in conjunction with multiple test systems and organ systems, to study how exposure variation has on the outcome of an in vitro test system."@en-US .

<https://vhp4safety.github.io/glossary#Q5026>
        rdf:type        owl:Class ;
        rdfs:label      "thyroxine"@en-US ;
        ncit:C42610     "T4"@en-US ;
