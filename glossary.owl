<https://vhp4safety.github.io/glossary#VHP0000390>
        rdf:type        owl:Class ;
        rdfs:label      "Leiden University"@en-US ;
        dc:description  "Public university in the Netherlands"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000203>
        rdf:type        owl:Class ;
        rdfs:label      "Acute Kidney Injury"@en-US ;
        dc:description  "Abrupt loss of kidney function that develops within 48 hours"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000118>
        rdf:type        owl:Class ;
