<https://vhp4safety.github.io/glossary#VHP0000298>
        rdf:type        owl:Class ;
        rdfs:label      "ORCID"@en-US ;
        dc:description  "Nonproprietary alphanumeric code to uniquely identify scientific and other academic authors"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000172>
        rdf:type        owl:Class ;
        rdfs:label      "In vivo"@en-US ;
