        dc:description  "Software used to transform and process chemical information items."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000414>
        rdf:type    owl:Class ;
        rdfs:label  "DTU National Food Institute"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000022>
