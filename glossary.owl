        dc:description  "compound that inhibits or blocks the phosphatase activity of calcineurin"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000043>
        rdf:type        owl:Class ;
        rdfs:label      "Identifier"@en-US ;
        dc:description  "The unique identifier for an administered item within a registration authority."@en-US .

<https://vhp4safety.github.io/glossary#Q38>
        rdf:type        owl:Class ;
        rdfs:label      "rotenone"@en-US ;
        dc:description  "chemical compound, InChIKey JUVIOZPCNVVQFO-HBGVWJBISA-N, CAS registry number 83-79-4"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000224>
        rdf:type        owl:Class ;
        rdfs:label      "CHO-K1"@en-US ;
        dc:description  "Chinese hamster ovary cells, subclone from parental CHO cell line that was initiated from an ovary biopsy of an adult Chinese hamster in 1957."@en-US .

<https://vhp4safety.github.io/glossary#Q4723>
        rdf:type        owl:Class ;
        rdfs:label      "dinoseb"@en-US ;
        dc:description  "mixture"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000139>
        rdf:type        owl:Class ;
        rdfs:label      "Retrieval-Augmented Generation"@en-US ;
        ncit:C42610     "RAG"@en-US ;
        dc:description  "A technique that combines retrieval systems (e.g., search engines or databases) with generation models like LLMs. The retrieval system provides relevant context or data, which the generation model then uses to create accurate and context-aware responses."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000013>
        rdf:type        owl:Class ;
        rdfs:label      "Read Across"@en-US ;
        dc:description  "A common approach in the risk assessment in order to examine structural similarities between the source and the target substances when there is a lack of information on their physical-chemical, toxicological properties, or environmental fate."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000405>
        rdf:type    owl:Class ;
        rdfs:label  "Dutch Burns Foundation"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000381>
        rdf:type        owl:Class ;
        rdfs:label      "bio.tools"@en-US ;
        dc:description  "Essential scientific and technical information about software tools, databases and services for bioinformatics and the life sciences"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000109>
        rdf:type        owl:Class ;
        rdfs:label      "Template"@en-US ;
        dc:description  "A thing that is used as a model for producing other similar examples."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000296>
        rdf:type        owl:Class ;
        rdfs:label      "Controlled vocabulary"@en-US ;
        dc:description  "Standardized and organized sets of words and phrases for retrieval and disambiguation of information, distinguishing preferred terms from non-preferred terms"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000170>
        rdf:type        owl:Class ;
        rdfs:label      "endocrine disrupting chemicals"@en-US ;
        ncit:C42610     "EDCs"@en-US ;
        dc:description  "chemicals that can interfere with endocrine or hormonal systems at certain doses"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000085>
        rdf:type        owl:Class ;
        rdfs:label      "European Centre for Ecotoxicology and Toxicology of Chemicals"@en-US ;
        ncit:C42610     "ECTOC"@en-US ;
        dc:description  "The European Centre for Ecotoxicology and Toxicology of Chemicals (ECETOC) is a scientific, non-profit, non-commercial and non-governmental association. Established in 1978, ECETOC's main objective is to identify, evaluate, and through such knowledge help industry to minimise any potentially adverse effects on human health and the environment that may arise from the manufacture and use of chemicals, biomaterials and pharmaceuticals."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000351>
        rdf:type    owl:Class ;
        rdfs:label  "ONTOX Physiological Maps"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000266>
        rdf:type    owl:Class ;
        rdfs:label  "Exposure scenario"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000140>
        rdf:type        owl:Class ;
        rdfs:label      "Explainability"@en-US ;
        dc:description  "The ability to describe the internal logic and mechanics of a model, such as Large Language Models and machine learning systems, to understand the way the model is trained and how predictions and answers are generated by the model."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000055>
        rdf:type        owl:Class ;
        rdfs:label      "Model"@en-US ;
        dc:description  "A simplified (generally mathematical) representation of a real system (e.g. of system: an organism, an organ, a cell, etc.)"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000321>
        rdf:type    owl:Class ;
        rdfs:label  "AOP-Wiki Snorql UI"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000236>
        rdf:type        owl:Class ;
        rdfs:label      "Liquid Chromatography-Mass Spectrometry"@en-US ;
        ncit:C42610     "LC-MS"@en-US ;
        dc:description  "Analytical chemistry technique with on-line coupling of liquid chromatography to mass spectrometry"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000110>
        rdf:type        owl:Class ;
        rdfs:label      "Non-Animal Methodology"@en-US ;
        rdfs:seeAlso    <https://vhp4safety.github.io/glossary#VHP0000010> ;
        dc:description  "A collection of methods to evaluate the potential for a chemical to cause systematic toxicity without using tests on animals (see also New Approach Methodology)."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000025>
        rdf:type        owl:Class ;
        rdfs:label      "Adverse Outcome"@en-US ;
        ncit:C42610     "AO"@en-US ;
        dc:description  "A specialised type of key event that is generally accepted as being of regulatory significance on the basis of correspondence to an established protection goal or equivalence to an apical endpoint in an accepted regulatory guideline toxicity test."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000417>
        rdf:type     owl:Class ;
        rdfs:label   "National Research Data Infrastructure"@en-US ;
        ncit:C42610  "NFDI"@en-US .

<https://vhp4safety.github.io/glossary#Q81>
        rdf:type        owl:Class ;
        rdfs:label      "bisphenol S"@en-US ;
        ncit:C42610     "BPS"@en-US ;
        dc:description  "chemical compound, InChIKey VPWNQTHUCYMVMZ-UHFFFAOYSA-N, CAS registry number 80-09-1"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000393>
        rdf:type        owl:Class ;
        rdfs:label      "University Medical Center Utrecht"@en-US ;
        ncit:C42610     "UMC Utrecht"@en-US ;
        dc:description  "Academic hospital in Utrecht, Netherlands"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000206>
        rdf:type        owl:Class ;
        rdfs:label      "Dopaminergic neurons"@en-US ;
        dc:description  "Neurons whose primary neurotransmitter is DOPAMINE."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000182>
        rdf:type        owl:Class ;
        rdfs:label      "Apoptosis"@en-US ;
        dc:description  "A regulated cell death mechanism characterized by distinctive morphologic changes in the nucleus and cytoplasm, including the endonucleolytic cleavage of genomic DNA, at regularly spaced, internucleosomal sites, i.e., DNA FRAGMENTATION. It is genetically programmed and serves as a balance to mitosis in regulating the size of animal tissues and in mediating pathologic processes associated with tumor growth."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000097>
        rdf:type        owl:Class ;
        rdfs:label      "Widget"@en-US ;
        dc:description  "A small software application that is designed to provide a specific piece of information (such as news, weather, or traffic updates) or a specific function (such as taking notes or controlling another application) on demand."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000363>
        rdf:type        owl:Class ;
        rdfs:label      "Reactome"@en-US ;
        dc:description  "Database of biological pathways"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000278>
        rdf:type     owl:Class ;
        rdfs:label   "Raw Primary Commodity"@en-US ;
        ncit:C42610  "RPC"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000152>
        rdf:type        owl:Class ;
        rdfs:label      "Process Flow Step"@en-US ;
        dc:description  "One of the generic stages in the VHP4Safety human-based risk-assessment workflow, used to structure tools, data and models along the risk assessment process."@en-US .

<https://vhp4safety.github.io/glossary#Q5180>
        rdf:type        owl:Class ;
        rdfs:label      "dopamine"@en-US ;
        dc:description  "organic chemical that functions both as a hormone and a neurotransmitter, InChIKey VYFYYTLLBUKUHU-UHFFFAOYSA-N, CAS registry number 51-61-6"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000067>
        rdf:type        owl:Class ;
        rdfs:label      "Research Line 3"@en-US ;
        ncit:C42610     "RL3"@en-US ;
        dc:description  "Implementing the Virtual Human Platform."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000333>
        rdf:type    owl:Class ;
        rdfs:label  "cpLogD"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000248>
        rdf:type        owl:Class ;
        rdfs:label      "Area Under the Curve"@en-US ;
        ncit:C42610     "AUC"@en-US ;
        dc:description  "A statistical means of summarizing information from a series of measurements on one individual. It is frequently used in clinical pharmacology where the AUC from serum levels can be interpreted as the total uptake of whatever has been administered. As a plot of the concentration of a drug against time, after a single dose of medicine, producing a standard shape curve, it is a means of comparing the bioavailability of the same drug made by different companies. (From Winslade, Dictionary of Clinical Research, 1992)"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000122>
        rdf:type        owl:Class ;
        rdfs:label      "SCRUM Master"@en-US ;
        dc:description  "A person with the role in the SCRUM method who ensures the team follows the scrum practices and that the backlog, sprint, user stories and epics are clear."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000037>
        rdf:type        owl:Class ;
        rdfs:label      "Secure Shell"@en-US ;
        ncit:C42610     "ssh"@en-US ;
        dc:description  "A network protocol to access a network service remotely and securely."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000303>
        rdf:type        owl:Class ;
        rdfs:label      "Cell Line Ontology"@en-US ;
        ncit:C42610     "CLO"@en-US ;
        dc:description  "Ontology which describes anatomic origin and nature of eukaryotic cell lines"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000218>
        rdf:type        owl:Class ;
        rdfs:label      "SH-SY5Y"@en-US ;
        dc:description  "Cell line"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000194>
        rdf:type        owl:Class ;
        rdfs:label      "Brain-Derived Neurotrophic Factor"@en-US ;
        ncit:C42610     "BDNF"@en-US ;
        dc:description  "Brain-derived neurotrophic factor (247 aa, ~28 kDa) is encoded by the human BDNF gene. This protein plays a role in both the development of the nervous system and neuronal survival."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000007>
        rdf:type        owl:Class ;
        rdfs:label      "Lowest Observed Adverse Effect Level"@en-US ;
        ncit:C42610     "LOAEL"@en-US ;
        dc:description  "The lowest exposure level of a chemical stressor evaluated in a toxicity test that shows harmful effects on a plant or animal."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000375>
        rdf:type        owl:Class ;
        rdfs:label      "Embase"@en-US ;
        dc:description  "Database"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000164>
        rdf:type        owl:Class ;
        rdfs:label      "milk thistle (Silybum marianum)"@en-US ;
        dc:description  "species of plant of genus Silybum in family Asteraceae"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000079>
        rdf:type        owl:Class ;
        rdfs:label      "European Medicines Agency"@en-US ;
        ncit:C42610     "EMA"@en-US ;
        dc:description  "An agency of the European Union (EU) in charge of the evaluation and supervision of pharmaceutical products."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000345>
        rdf:type    owl:Class ;
        rdfs:label  "Molecular AOP Analyser"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000134>
        rdf:type        owl:Class ;
        rdfs:label      "Agent"@en-US ;
        dc:description  "A software entity that uses a language model to autonomously perform specific tasks by interpreting prompts, interacting with data or systems, and generating results."@en-US .

<https://vhp4safety.github.io/glossary#Q5162>
        rdf:type        owl:Class ;
        rdfs:label      "quercetin"@en-US ;
        dc:description  "polyphenol of the family of flavonoids, InChIKey REFJWTPEDVJJIY-UHFFFAOYSA-N, CAS registry number 117-39-5"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000400>
        rdf:type        owl:Class ;
        rdfs:label      "Ministry of Agriculture, Nature and Food Quality"@en-US ;
        ncit:C42610     "LNV"@en-US ;
        dc:description  "Agriculture ministry of Netherlands"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000049>
        rdf:type        owl:Class ;
        rdfs:label      "Metadata"@en-US ;
        dc:description  "The data that provide information about one or more aspects of the data that is used to summarize basic information about data that can make tracking and working with specific data easier."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000315>
        rdf:type    owl:Class ;
        rdfs:label  "VHP4Safety Glossary"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000104>
        rdf:type        owl:Class ;
        rdfs:label      "Exposure Assessment"@en-US ;
        dc:description  "The process of assessing the magnitude, frequency and duration of exposure of a certain organism to a certain agent; OF the process of assessing the total external (or internal) exposure following one or more exposure/use scenarios that are described in terms of route, extent, frequency and duration of exposure, including exposure via more than one exposure route (aggregated exposure) and exposure to multiple chemicals (cumulative exposure)."@en-US .

<https://vhp4safety.github.io/glossary#Q4729>
        rdf:type        owl:Class ;
        rdfs:label      "α-endosulfan"@en-US ;
        dc:description  "type of a chemical entity, InChIKey RDYMFSUJUZBWLH-BEJSPLBDSA-N"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000291>
        rdf:type        owl:Class ;
        rdfs:label      "Model Context Protocol"@en-US ;
        ncit:C42610     "MCP"@en-US ;
        dc:description  "Protocol for applications to provide context to LLMs"@en-US .

<https://vhp4safety.github.io/glossary#Q4790>
        rdf:type        owl:Class ;
        rdfs:label      "triclosan"@en-US ;
        dc:description  "antimicrobial agent, InChIKey XEFQLINVKFYRCS-UHFFFAOYSA-N, CAS registry number 3380-34-5"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000019>
        rdf:type        owl:Class ;
        rdfs:label      "European Centre for the Validation of Alternative Methods"@en-US ;
        ncit:C42610     "ECVAM"@en-US ;
        dc:description  "The EU Reference Laboratory for alternatives to animal testing, located in Ispra, Italy."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000080>
        rdf:type        owl:Class ;
        rdfs:label      "College ter Beoordeling van Geneesmiddelen"@en-US ;
        ncit:C42610     "CBG"@en-US ;
        dc:description  "Medicines Evaluation Board. The Dutch authority that evaluates and regulates medicines for human and veterinary use."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000387>
        rdf:type        owl:Class ;
        rdfs:label      "University of Applied Sciences Utrecht"@en-US ;
        ncit:C42610     "HU"@en-US ;
        dc:description  "University of applied sciences in Utrecht, the Netherlands"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000261>
        rdf:type     owl:Class ;
        rdfs:label   "Benchmark Dose Lower Confidence Limit"@en-US ;
        ncit:C42610  "BMDL"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000176>
        rdf:type        owl:Class ;
        rdfs:label      "Nephrotoxicity"@en-US ;
        dc:description  "Toxicity that causes injury to the kidney or damages its function. This can include nephritis, renal failure, injury to kidney."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000050>
        rdf:type        owl:Class ;
        rdfs:label      "Open Data"@en-US ;
        dc:description  "A (collection of) data that can be used, studied, and modified without restriction, and which can be copied and redistributed in modified or unmodified form either without restriction, or with restrictions only to ensure that further recipients can also do these things."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000357>
        rdf:type    owl:Class ;
        rdfs:label  "R-ODAF"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000231>
        rdf:type        owl:Class ;
        rdfs:label      "Half Maximal Inhibitory Concentration"@en-US ;
        ncit:C42610     "IC50"@en-US ;
        dc:description  "The effective concentration of an inhibitor, which produces 50% of the maximum possible response for that inhibitor."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000146>
        rdf:type        owl:Class ;
        rdfs:label      "Central Access Point"@en-US ;
        ncit:C42610     "CAP"@en-US ;
        dc:description  "A website that provides toxicological risk assessors an easily accessible and structured analysis framework including tools developed within VHP4Safety."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000020>
        rdf:type        owl:Class ;
        rdfs:label      "European Chemical Agency"@en-US ;
        ncit:C42610     "ECHA"@en-US ;
        dc:description  "The European Chemicals Agency (ECHA) is responsible for, among other things, implementing European Union legislation on chemicals, such as REACH (Registration, Evaluation, Authorization and Restriction of Chemicals) and CLP (Classification, Labelling and Packaging of substances and mixtures)."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000412>
        rdf:type        owl:Class ;
        rdfs:label      "Joint Research Centre"@en-US ;
        ncit:C42610     "JRC"@en-US ;
        dc:description  "European Commission's science and knowledge service"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000327>
        rdf:type        owl:Class ;
        rdfs:label      "BridgeDb"@en-US ;
        dc:description  "Framework to map identifiers between various biological databases"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000201>
        rdf:type        owl:Class ;
        rdfs:label      "Parkinson's Disease"@en-US ;
        ncit:C42610     "PD"@en-US ;
        dc:description  "A progressive, degenerative neurologic disease characterized by a TREMOR that is maximal at rest, retropulsion (i.e. a tendency to fall backwards), rigidity, stooped posture, slowness of voluntary movements, and a masklike facial expression. Pathologic features include loss of melanin containing neurons in the substantia nigra and other pigmented nuclei of the brainstem. LEWY BODIES are present in the substantia nigra and locus coeruleus but may also be found in a related condition (LEWY BODY DISEASE, DIFFUSE) characterized by dementia in combination with varying degrees of parkinsonism. (Adams et al., Principles of Neurology, 6th ed, p1059, pp1067-75)"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000116>
        rdf:type        owl:Class ;
        rdfs:label      "Adapter"@en-US ;
        dc:description  "A framework to fine-tune (large language) models by adding a small number of external parameters without the need of the entire (large language) model."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000092>
        rdf:type        owl:Class ;
        rdfs:label      "Workflow"@en-US ;
        dc:description  "An orchestrated and repeatable multi-step process to coordinate multiple tasks and their data dependencies."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000399>
        rdf:type        owl:Class ;
        rdfs:label      "Certara"@en-US ;
        dc:description  "Company in St Louis, United States"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000273>
        rdf:type        owl:Class ;
        rdfs:label      "Human biomonitoring"@en-US ;
        dc:description  "Measurement of the body burden of toxic chemical compounds, elements, or their metabolites, in biological substances"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000188>
        rdf:type        owl:Class ;
        rdfs:label      "Deiodinase"@en-US ;
        ncit:C42610     "DIO"@en-US ;
        dc:description  "Class of enzymes"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000062>
        rdf:type             owl:Class ;
        rdfs:label           "Physiologically based kinetic model"@en-US ;
        ncit:C42610          "PBK model"@en-US ;
        dc:description       "See PBPK model (these terms are equivalent)"@en-US ;
        owl:equivalentClass  <https://vhp4safety.github.io/glossary#VHP0000059> .

<https://vhp4safety.github.io/glossary#VHP0000369>
        rdf:type    owl:Class ;
        rdfs:label  "PhysB"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000243>
        rdf:type    owl:Class ;
        rdfs:label  "H2DCFDA assay"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000158>
        rdf:type        owl:Class ;
        rdfs:label      "Adverse Outcome (Process Flow Step)"@en-US ;
        dc:description  "A process flow step that is named after adverse outcome, although specifically refers to clinical and epidemiological effects. It categorizes services that provide information on the toxicological endpoints and adverse outcomes at a clinical or epidemiological level of chemical exposures."@en-US ;
        dct:relation    <https://vhp4safety.github.io/glossary#VHP0000025> .

<https://vhp4safety.github.io/glossary#VHP0000032>
        rdf:type        owl:Class ;
        rdfs:label      "Docker"@en-US ;
        dc:description  "A service to create a virtual computer environment which can include the required software/tools to conduct a scientific work."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000339>
        rdf:type    owl:Class ;
        rdfs:label  "Farmacotherapeutisch Kompas"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000213>
        rdf:type        owl:Class ;
        rdfs:label      "Neural Progenitor Cells"@en-US ;
        ncit:C42610     "NPCs"@en-US ;
        dc:description  "An undifferentiated cell derived from a neural stem cell, with a limited capacity to self-renew (Dibajnia and Morshead, 2013) and the ability to generate multiple types of lineage-restricted progenitors, contributing to the formation of neurons, astrocytes, and oligodendrocytes."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000128>
        rdf:type        owl:Class ;
        rdfs:label      "User Story"@en-US ;
        dc:description  "A simple, clear description of a desired feature or functionality from the perspective of the end user. Typically follows the format: 'As as [user], I want [feature], so that [benefit].'. Each task in the backlog should be contributing to as user story, each user story should be contributing to an epic."@en-US .

<https://vhp4safety.github.io/glossary#Q5156>
        rdf:type        owl:Class ;
        rdfs:label      "indocyanine green"@en-US ;
        dc:description  "chemical compound, InChIKey MOFVSTNWEDAEEK-UHFFFAOYSA-M, CAS registry number 3599-32-4"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000002>
        rdf:type        owl:Class ;
        rdfs:label      "Benchmark Dose"@en-US ;
        rdfs:seeAlso    <https://vhp4safety.github.io/glossary#VHP0000003> ;
        ncit:C42610     "BMD"@en-US ;
        dc:description  "See Benchmark dose modeling"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000309>
        rdf:type        owl:Class ;
        rdfs:label      "Medical Subject Headings"@en-US ;
        ncit:C42610     "MeSH"@en-US ;
        dc:description  "Controlled vocabulary for the purpose of indexing journal articles and books in the life sciences"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000370>
        rdf:type    owl:Class ;
        rdfs:label  "Gaussian plume drift model"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000285>
        rdf:type        owl:Class ;
        rdfs:label      "REST API"@en-US ;
        dc:description  "Architectural style for distributed hypermedia systems"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000074>
        rdf:type        owl:Class ;
        rdfs:label      "Work Package 2.4"@en-US ;
        ncit:C42610     "WP2.4"@en-US ;
        dc:description  "Age and gender specific safety - Case study Thyroid mediated developmental neurotoxicity: objectives to collect mechanistic physiological data, determine critical pathways, establish quantitative AOP network, identify gender-specific sentitivities and compounds that discriminate, and assess the safety of compound exposure."@en-US .

<https://vhp4safety.github.io/glossary#Q1877>
        rdf:type        owl:Class ;
        rdfs:label      "paraquat"@en-US ;
        dc:description  "chemical compound, InChIKey INFDPOAKFNIJBF-UHFFFAOYSA-N, CAS registry number 4685-14-7"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000340>
        rdf:type    owl:Class ;
        rdfs:label  "Flame"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000255>
        rdf:type        owl:Class ;
        rdfs:label      "Ordinary Differential Equation"@en-US ;
        ncit:C42610     "ODE"@en-US ;
        dc:description  "Differential equation containing one or more functions of one independent variable and its derivatives"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000044>
        rdf:type        owl:Class ;
        rdfs:label      "Findable, Accessible, Interoperable, Reusable"@en-US ;
        ncit:C42610     "FAIR"@en-US ;
        dc:description  "The FAIR principles emphasise machine-actionability (i.e., the capacity of computational systems to find, access, interoperate, and reuse data with none or minimal human intervention) because humans increasingly rely on computational support to deal with data as a result of the increase in volume, complexity, and creation speed of data."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000310>
        rdf:type        owl:Class ;
        rdfs:label      "Gene Ontology"@en-US ;
        ncit:C42610     "GO"@en-US ;
        dc:description  "Ontology for describing the function of genes and gene products"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000225>
        rdf:type        owl:Class ;
        rdfs:label      "MDCK1"@en-US ;
        dc:description  "Cell line"@en-US .

<https://vhp4safety.github.io/glossary#Q4724>
        rdf:type        owl:Class ;
        rdfs:label      "(S)-dinoseb"@en-US ;
        dc:description  "type of a chemical entity, InChIKey OWZPCEFYPSAJFR-LURJTMIESA-N"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000014>
        rdf:type        owl:Class ;
        rdfs:label      "Teratology"@en-US ;
        dc:description  "Scientific field that studies the causes, mechanisms, and classes of congenital malformations in animals and plants."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000406>
        rdf:type        owl:Class ;
        rdfs:label      "Cosmetics Europe"@en-US ;
        dc:description  "Organization in Brussels, Belgium"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000382>
        rdf:type    owl:Class ;
        rdfs:label  "Taxila.nl"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000297>
        rdf:type        owl:Class ;
        rdfs:label      "Digital Object Identifier"@en-US ;
        ncit:C42610     "DOI"@en-US ;
        dc:description  "ISO standard unique string identifier for a digital object"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000171>
        rdf:type        owl:Class ;
        rdfs:label      "In vitro"@en-US ;
        dc:description  "Outside a natural biological environment"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000086>
        rdf:type        owl:Class ;
        rdfs:label      "Task Force"@en-US ;
        ncit:C42610     "TF"@en-US ;
        dc:description  "Cross work package effort to reach some goal."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000352>
        rdf:type    owl:Class ;
        rdfs:label  "OP PBK Model"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000267>
        rdf:type    owl:Class ;
        rdfs:label  "External exposure"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000141>
        rdf:type        owl:Class ;
        rdfs:label      "User experience"@en-US ;
        ncit:C42610     "UX"@en-US ;
        dc:description  "The experience a user would go through when interacting with a company, its services, and its products."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000056>
        rdf:type             owl:Class ;
        rdfs:label           "Absorption, Distribution, Metabolism, and Excretion"@en-US ;
        ncit:C42610          "ADME"@en-US ;
        dc:description       "Absorption, distribution, metabolism, and excretion of a substance (toxic or not) in a living organism, following exposure to this substance"@en-US ;
        owl:equivalentClass  <https://vhp4safety.github.io/glossary#VHP0000058> , <https://vhp4safety.github.io/glossary#VHP0000057> .

<https://vhp4safety.github.io/glossary#VHP0000322>
        rdf:type    owl:Class ;
        rdfs:label  "ArrayAnalysis"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000237>
        rdf:type        owl:Class ;
        rdfs:label      "Enzyme-Linked Immunosorbent Assay"@en-US ;
        ncit:C42610     "ELISA"@en-US ;
        dc:description  "An immunoassay utilizing an antibody labeled with an enzyme marker such as horseradish peroxidase. While either the enzyme or the antibody is bound to an immunosorbent substrate, they both retain their biologic activity; the change in enzyme activity as a result of the enzyme-antibody-antigen reaction is proportional to the concentration of the antigen and can be measured spectrophotometrically or with the naked eye. Many variations of the method have been developed."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000111>
        rdf:type        owl:Class ;
        rdfs:label      "Machine-Readable Data"@en-US ;
        dc:description  "A data or dataset that is in a format that can be read by a computer. It usually contrasts with human-readable data."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000026>
        rdf:type        owl:Class ;
        rdfs:label      "Key Event"@en-US ;
        ncit:C42610     "KE"@en-US ;
        dc:description  "A change in biological or physiological state that is both measurable and essential to the progression of a defined biological perturbation leading to a specific adverse outcome."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000418>
        rdf:type        owl:Class ;
        rdfs:label      "Institute for Risk Assessment Sciences"@en-US ;
        ncit:C42610     "IRAS"@en-US ;
        dc:description  "Universiteit Utrecht"@en-US .

<https://vhp4safety.github.io/glossary#Q82>
        rdf:type        owl:Class ;
        rdfs:label      "tetrabromobisphenol A"@en-US ;
        ncit:C42610     "TBBPA"@en-US ;
        dc:description  "bisphenol, InChIKey VEORPZCZECFIRK-UHFFFAOYSA-N, CAS registry number 79-94-7"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000394>
        rdf:type        owl:Class ;
        rdfs:label      "Erasmus MC"@en-US ;
        dc:description  "Hospital in Rotterdam, Netherlands"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000207>
        rdf:type        owl:Class ;
        rdfs:label      "Blood-Cerebrospinal Fluid Barrier"@en-US ;
        ncit:C42610     "BCSFB"@en-US ;
        dc:description  "Functional component of the vertebrate central nervous system"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000183>
        rdf:type        owl:Class ;
        rdfs:label      "Fibrosis"@en-US ;
        dc:description  "Formation of excess fibrous connective tissue in an organ or tissue in a reparative or reactive process"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000098>
        rdf:type        owl:Class ;
        rdfs:label      "Catalog"@en-US ;
        dc:description  "A systemic collection of items of the same type."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000364>
        rdf:type        owl:Class ;
        rdfs:label      "Cytoscape"@en-US ;
        dc:description  "Open source software platform for visualizing molecular interaction networks and biological pathways"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000279>
        rdf:type        owl:Class ;
        rdfs:label      "Bradford-Hill criteria"@en-US ;
        dc:description  "Principles for establishing a causal relationship"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000153>
        rdf:type        owl:Class ;
        rdfs:label      "Chemical Characteristics and Hazard identification (Process Flow Step)"@en-US ;
        dc:description  "A process flow step that is named after hazard assessment and considered to be cheminformatics-based. It categorizes services that use molecular structures, chemical descriptors, and databases to predict or analyze the properties, behavior, and potential risks of chemical substances."@en-US ;
        dct:relation    <https://vhp4safety.github.io/glossary#VHP0000102> .

<https://vhp4safety.github.io/glossary#VHP0000068>
        rdf:type        owl:Class ;
        rdfs:label      "Work Package 1.1"@en-US ;
        ncit:C42610     "WP1.1"@en-US ;
        dc:description  "Building the ICT infrastructure for the VHP: objectives to develop the technical infrastructure, setting up a predictive platform, developing analysis workflows, making services and data available and interoperable."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000334>
        rdf:type    owl:Class ;
        rdfs:label  "Danish (Q)SAR Database"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000249>
        rdf:type        owl:Class ;
        rdfs:label      "Apparent Permeability"@en-US ;
        ncit:C42610     "Papp"@en-US ;
        dc:description  "A biochemical parameter representing the apparent permeability of a compound specifically between the compartments."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000123>
        rdf:type        owl:Class ;
        rdfs:label      "Product Owner"@en-US ;
        dc:description  "A key role in SCRUM method for people who have a clear view of the long term goals of the project and the expertise of the team members. People with this role review the epics and user stories and prioritize the tasks in the backlog."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000038>
        rdf:type        owl:Class ;
        rdfs:label      "Strato"@en-US ;
        dc:description  "An internet hosting service provider that supplies the servers where the virtual platform is built."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000304>
        rdf:type        owl:Class ;
        rdfs:label      "BioAssay Ontology"@en-US ;
        ncit:C42610     "BAO"@en-US ;
        dc:description  "Ontology to annotate experiments in the field of the life sciences"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000219>
        rdf:type        owl:Class ;
        rdfs:label      "HepG2"@en-US ;
        dc:description  "human hepatocellular carcinoma (HCC) cells (p53-wt)."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000280>
        rdf:type        owl:Class ;
        rdfs:label      "GitHub"@en-US ;
        dc:description  "Hosting service for software projects using Git"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000195>
        rdf:type        owl:Class ;
        rdfs:label      "KLF9"@en-US ;
        dc:description  "Protein-coding gene in the species Homo sapiens"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000008>
        rdf:type        owl:Class ;
        rdfs:label      "Monte Carlo Risk Assessment"@en-US ;
        rdfs:seeAlso    <https://vhp4safety.github.io/glossary#VHP0000009> ;
        ncit:C42610     "MCRA"@en-US ;
        dc:description  "See Monte Carlo Risk Assessment calculation model."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000376>
        rdf:type        owl:Class ;
        rdfs:label      "MEDLINE"@en-US ;
        dc:description  "Biomedical bibliographical database"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000250>
        rdf:type        owl:Class ;
        rdfs:label      "Intrinsic Clearance"@en-US ;
        ncit:C42610     "CLint"@en-US ;
        dc:description  "Intrinsic metabolic clearance is defined as ratio of maximum metabolism rate, Vmax, and the Michaelis-Menten constant, Km."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000165>
        rdf:type    owl:Class ;
        rdfs:label  "organophosphate pesticides"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000346>
        rdf:type    owl:Class ;
        rdfs:label  "Molecular AOP Builder"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000220>
        rdf:type        owl:Class ;
        rdfs:label      "Caco-2"@en-US ;
        dc:description  "Cell line"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000135>
        rdf:type        owl:Class ;
        rdfs:label      "Multimodal Model"@en-US ;
        dc:description  "A model capable of processing and generating responses from multiple types of data, such as text, images, and audio."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000401>
        rdf:type        owl:Class ;
        rdfs:label      "Dutch Kidney Foundation"@en-US ;
        dc:description  "Kidney research funding body based in Bussum, Netherlands"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000316>
        rdf:type    owl:Class ;
        rdfs:label  "AOP-Builder"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000105>
        rdf:type        owl:Class ;
        rdfs:label      "Hackathon"@en-US ;
        dc:description  "An event in which computer programmers collaborate intensively with one another and sometimes with people in other specialties over a relatively short period of time to create code usually for a new software product or service."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000292>
        rdf:type        owl:Class ;
        rdfs:label      "Artificial Intelligence"@en-US ;
        ncit:C42610     "AI"@en-US ;
        dc:description  "Field that develops and studies software enabling machines to exhibit intelligent behavior"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000081>
        rdf:type     owl:Class ;
        rdfs:label   "nan"@en-US ;
        ncit:C42610  "ZIN"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000388>
        rdf:type        owl:Class ;
        rdfs:label      "Maastricht University"@en-US ;
        ncit:C42610     "UM"@en-US ;
        dc:description  "Public university in Maastricht"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000262>
        rdf:type     owl:Class ;
        rdfs:label   "Lowest Observed Effect Concentration"@en-US ;
        ncit:C42610  "LOEC"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000177>
        rdf:type        owl:Class ;
        rdfs:label      "Neurotoxicity"@en-US ;
        dc:description  "Toxicity that causes injury to the central or peripheral nervous system or damages its function. This can include stroke, multiple sclerosis, encephalopathy, dementia, Alzheimer's disease, amnesia, dyskinesia, Parkinson's disease, tremor, convulsions and Guillain Barre syndrome."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000051>
        rdf:type        owl:Class ;
        rdfs:label      "Resource Description Framework"@en-US ;
        rdfs:seeAlso    <https://vhp4safety.github.io/glossary#VHP0000117> ;
        ncit:C42610     "RDF"@en-US ;
        dc:description  "A globally-accepted framework for data and knowledge representation that is intended to be read and interpreted by machines."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000358>
        rdf:type     owl:Class ;
        rdfs:label   "Research Object Builder for Open Toxicology"@en-US ;
        ncit:C42610  "ROBOT"@en-US .

<https://vhp4safety.github.io/glossary/glossary#>
        rdf:type         owl:Ontology ;
        dct:contributor  "Egon Willighagen"@en-US , "Javier Millán Acosta"@en-US , "Marvin Martens"@en-US , "Ozan Çınar"@en-US ;
        dct:title        "VHP4Safety Glossary"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000232>
        rdf:type        owl:Class ;
        rdfs:label      "Transcriptomics"@en-US ;
        dc:description  "The analysis of transcriptomes, or a set of all the RNA molecules in a specific cell, tissue etc."@en-US .

<https://vhp4safety.github.io/glossary#Q4731>
        rdf:type        owl:Class ;
        rdfs:label      "ethylenebis(dithiocarbamate)"@en-US ;
        dc:description  "type of a chemical entity, InChIKey AWYFNIZYMPNGAI-UHFFFAOYSA-L"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000147>
        rdf:type        owl:Class ;
        rdfs:label      "Exposure"@en-US ;
        dc:description  "Contact between a toxicological agent and an outer boundary of an organism."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000021>
        rdf:type        owl:Class ;
        rdfs:label      "European Food Safety Authority"@en-US ;
        ncit:C42610     "EFSA"@en-US ;
        dc:description  "The European Food Safety Authority (EFSA) is responsible for providing scientific advice on risks related to food and animal feed throughout the entire supply chain in the European Union."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000413>
        rdf:type        owl:Class ;
        rdfs:label      "National Institutes of Health"@en-US ;
        ncit:C42610     "NIH"@en-US ;
        dc:description  "US government medical research agency"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000328>
        rdf:type        owl:Class ;
        rdfs:label      "CDK Depict"@en-US ;
        dc:description  "Web application for generating chemical structure depictions from SMILES"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000202>
        rdf:type        owl:Class ;
        rdfs:label      "Allan-Herndon-Dudley Syndrome"@en-US ;
        ncit:C42610     "AHDS"@en-US ;
        dc:description  "A syndrome with neuromuscular involvement characterized by infantile hypotonia, muscular hypoplasia, spastic paraparesis with dystonic/athetoic movements, and severe cognitive deficiency."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000117>
        rdf:type        owl:Class ;
        rdfs:label      "Knowledge Graphs"@en-US ;
        rdfs:seeAlso    <https://vhp4safety.github.io/glossary#VHP0000051> ;
        ncit:C42610     "KGs"@en-US ;
        dc:description  "An organized and graphical representation of real world obejcts and their relationships, represented mostly as nodes and edges, respectively to store data entities and their interrelations. See also Resource Description Framework."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000093>
        rdf:type        owl:Class ;
        rdfs:label      "Cloud computing"@en-US ;
        dc:description  "A computer infrastructure that provides access to data resources, analysis software, and computer power to conduct analyses specific to a use case or research community."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000274>
        rdf:type        owl:Class ;
        rdfs:label      "Population variability"@en-US ;
        dc:description  "Differences in measurable biological values, characteristics, or traits, among individuals of a population or between population groups."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000189>
        rdf:type        owl:Class ;
        rdfs:label      "Monocarboxylate Transporter 8"@en-US ;
        ncit:C42610     "MCT8"@en-US ;
        dc:description  "Monocarboxylate transporter 8 (539 aa, ~60 kDa) is encoded by the human SLC16A2 gene. This protein is involved in cellular uptake of thyroxine (T4), triiodothyronine (T3), reverse triiodothyronine (rT3) and diiodothyronine."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000063>
        rdf:type        owl:Class ;
        rdfs:label      "In vitro in vivo extrapolation"@en-US ;
        ncit:C42610     "IVIVE"@en-US ;
        dc:description  "A method to conduct the qualitative or quantitative transposition of experimental results or observations made in vitro to predict phenomena in vivo, biological organisms."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000244>
        rdf:type    owl:Class ;
        rdfs:label  "CFDA assay"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000159>
        rdf:type        owl:Class ;
        rdfs:label      "Integrated Approaches to Testing and Assessment"@en-US ;
        ncit:C42610     "IATA"@en-US ;
        dc:description  "An assessment method puts together information from multiple sources used for toxicity assessment of chemical substances in regulatory context. IATA is coined by the OECD, for which case studies are conducted to establish IATAs."@en-US .

