        dc:description  "chemical compound, InChIKey RLBIQVVOMOPOHC-UHFFFAOYSA-N, CAS registry number 298-00-0"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000284>
        rdf:type        owl:Class ;
        rdfs:label      "RO-Crate"@en-US ;
        dc:description  "Method to aggregate and describing research data with associated metadata"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000199>
        rdf:type        owl:Class ;
        rdfs:label      "Synaptogenesis"@en-US ;
        dc:description  "Formation of synapses between neurons in the nervous system"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000073>
        rdf:type        owl:Class ;
