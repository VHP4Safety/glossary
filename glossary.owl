<https://vhp4safety.github.io/glossary#VHP0000166>
        rdf:type        owl:Class ;
        rdfs:label      "pesticide"@en-US ;
        dc:description  "Strictly, a substance intended to kill pests. In common usage, any substance used for controlling, preventing, or destroying animal, microbiological or plant pests."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000040>
        rdf:type        owl:Class ;
        rdfs:label      "VHP server 2"@en-US ;
        dc:description  "The server hosted in Strato where the Kubernetes structure is formed for orchestration of the Docker containers on VHP server 1."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000347>
