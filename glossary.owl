        dc:description  "Population of cells that originates from a primary culture, adapted to grow and divide under laboratory conditions"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000184>
        rdf:type        owl:Class ;
        rdfs:label      "Cholestasis"@en-US ;
        dc:description  "Impairment of the bile flow caused by obstruction within the liver, or outside the liver in the bile duct system."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000099>
        rdf:type        owl:Class ;
        rdfs:label      "Platform"@en-US ;
        dc:description  "A computer environment where a set of software and tools are hosted and made available for the use of others over the internet."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000365>
        rdf:type    owl:Class ;
        rdfs:label  "xploreaop"@en-US .

