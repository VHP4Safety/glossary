<https://vhp4safety.github.io/glossary#VHP0000149>
        rdf:type        owl:Class ;
        rdfs:label      "General Tools"@en-US ;
        dc:description  "Support software tools that can be used at several stages of a workflow."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000023>
        rdf:type        owl:Class ;
        rdfs:label      "Adverse Outcome Pathway"@en-US ;
        ncit:C42610     "AOP"@en-US ;
        dc:description  "An AOP describes a sequence of events commencing with initial interaction(s) of a stressor with a biomolecule within an organism that causes a perturbation in its biology (i.e., molecular initiating event, MIE), which can progress through a dependent series of intermediate key events (KEs) and culminate in an adverse outcome (AO) considered relevant to risk assessment or regulatory decision-making."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000415>
        rdf:type        owl:Class ;
        rdfs:label      "Statistics Netherlands"@en-US ;
        ncit:C42610     "CBS"@en-US ;
        dc:description  "Netherlands' principal government institution in charge of statistics and census data"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000391>
        rdf:type        owl:Class ;
        rdfs:label      "Wageningen University & Research"@en-US ;
        ncit:C42610     "WUR"@en-US ;
        dc:description  "University in the Netherlands"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000204>
        rdf:type        owl:Class ;
        rdfs:label      "Proximal tubule"@en-US ;
        dc:description  "In mammals, the proximal tubule is a nephron tubule that connects Bowman's capsule to the loop of Henle. It has a brush border epithelial morphology[GO]."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000119>
        rdf:type        owl:Class ;
        rdfs:label      "SCRUM"@en-US ;
        dc:description  "An agile way of working as a development team that uses time-boxed iterations called sprints to focus on fully executing smaller increments of a larger product. It includes clear bite-sized tasks, regular discussions and collaborative review. It tackles issues such as vague long term goals, poor teamwork and inefficient timespending."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000180>
        rdf:type        owl:Class ;
        rdfs:label      "Mitochondrial dysfunction"@en-US ;
        dc:description  "Mitochondrial dysfunction is a subtype of dysfunctioning: A process that performs an abnormal and incomplete mitochondrial function."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000095>
        rdf:type        owl:Class ;
        rdfs:label      "VHP server 3"@en-US ;
        dc:description  "The server hosted in Strato that is used for experimentation, learning, and testing the work that is carried out on VHP servers 1 and 2."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000361>
        rdf:type        owl:Class ;
        rdfs:label      "WikiPathways"@en-US ;
        dc:description  "Database of biological pathways"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000276>
        rdf:type        owl:Class ;
        rdfs:label      "Pharmacovigilance"@en-US ;
        dc:description  "The pharmacological science relating to the collection, detection, assessment, monitoring, and prevention of adverse effects with pharmaceutical product"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000150>
        rdf:type        owl:Class ;
        rdfs:label      "Case Study"@en-US ;
        dc:description  "A human-health scenario used as a guiding use case within the VHP4Safety Project to integrate data, models, and tools, and to formulate specific regulatory questions that the Virtual Human Platform should be able to answer."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000065>
        rdf:type        owl:Class ;
        rdfs:label      "Research Line 1"@en-US ;
        ncit:C42610     "RL1"@en-US ;
        dc:description  "Building the Virtual Human Platform."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000331>
        rdf:type        owl:Class ;
        rdfs:label      "CompTox"@en-US ;
        dc:description  "Chemical database"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000246>
        rdf:type        owl:Class ;
        rdfs:label      "Molecular docking"@en-US ;
        dc:description  "Attempt to predict the structure of the intermolecular complex formed between two or more molecules"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000120>
        rdf:type        owl:Class ;
        rdfs:label      "Sprint"@en-US ;
        dc:description  "A fixed time-box, usually 1-4 weeks, used in the SCRUM method of working. Per sprint, each team member works on selected tasks which they can (likely) finish within the sprint. Each sprint has meetings to plan the sprint, review the finished tasks and reflect to improve productivity."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000035>
        rdf:type        owl:Class ;
        rdfs:label      "Docker image"@en-US ;
        dc:description  "A representative file from which a docker container can be run and executed."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000301>
        rdf:type        owl:Class ;
        rdfs:label      "Uberon"@en-US ;
        dc:description  "Cross-species anatomy ontology for metazoan structures and development"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000216>
        rdf:type     owl:Class ;
        rdfs:label   "Endothelial-Like Cells"@en-US ;
        ncit:C42610  "ELC"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000192>
        rdf:type        owl:Class ;
        rdfs:label      "P-glycoprotein"@en-US ;
        ncit:C42610     "P-gp"@en-US ;
        dc:description  "A 170-kDa transmembrane glycoprotein from the superfamily of ATP-BINDING CASSETTE TRANSPORTERS. It serves as an ATP-dependent efflux pump for a variety of chemicals, including many ANTINEOPLASTIC AGENTS. Overexpression of this glycoprotein is associated with multidrug resistance (see DRUG RESISTANCE, MULTIPLE)."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000005>
        rdf:type     owl:Class ;
        rdfs:label   "Developmental Neurotoxicity"@en-US ;
        ncit:C42610  "DNT"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000373>
        rdf:type        owl:Class ;
        rdfs:label      "Europe PMC"@en-US ;
        dc:description  "Database of biomedical research"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000288>
        rdf:type        owl:Class ;
        rdfs:label      "CSV"@en-US ;
        dc:description  "Tabular data represented as comma-separated values in a text file."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000162>
        rdf:type        owl:Class ;
        rdfs:label      "WHO Human Health Risk Assessment Toolkit: Chemical Hazards"@en-US ;
        dc:description  "A publication that provides guidance on how to identify, gather, and use the information needed to assess chemical hazards, exposures, and related health risks. It was developed by the International Programme on Chemical Safety."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000077>
        rdf:type        owl:Class ;
        rdfs:label      "Work Package 3.3"@en-US ;
        ncit:C42610     "WP3.3"@en-US ;
        dc:description  "Training and Education: objectives to promote collaboration, facilitate transferability of methods and models, implementing new teaching modules, promote capacity building and awareness of stakeholders, improve skills regarding risk communication."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000343>
        rdf:type    owl:Class ;
        rdfs:label  "MINERVA"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000258>
        rdf:type    owl:Class ;
        rdfs:label  "Hazard characterization"@en-US .

<https://vhp4safety.github.io/glossary#Q4757>
        rdf:type        owl:Class ;
        rdfs:label      "PBDE-99"@en-US ;
        dc:description  "type of a chemical entity, InChIKey WHPVYXDFIXRKLN-UHFFFAOYSA-N, CAS registry number 60348-60-9"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000132>
        rdf:type        owl:Class ;
        rdfs:label      "Blood Brain Barrier"@en-US ;
        ncit:C42610     "BBB"@en-US ;
        dc:description  "A tissue to protect the brain and spinal cord from both toxic and pathogenic agents in the blood. It is formed by extensive tight junctions between vascular epithelial cells, which are polarized into luminal (blood-facing) and abluminal (brain-facing) plasma membrane domains."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000047>
        rdf:type        owl:Class ;
        rdfs:label      "Interoperable"@en-US ;
        dc:description  "To speed up discovery and uncover new insights, research data should be easily combined with other datasets, applications and workflows by humans as well as computer systems."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000313>
        rdf:type        owl:Class ;
        rdfs:label      "PeerTube"@en-US ;
        dc:description  "Decentralized video hosting network, based on free software"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000228>
        rdf:type        owl:Class ;
        rdfs:label      "Endpoint"@en-US ;
        dc:description  "The endpoint is a quantitive or qualitative interpretable standardized representation of a perturbation (a change from a defined reference state of a \"closed\" model system) that is measured by the bioassay. An endpoint consists of a series of data points, one for each perturbing agent (screened entity) tested the assay."@en-US .

<https://vhp4safety.github.io/glossary#Q4727>
        rdf:type        owl:Class ;
        rdfs:label      "endosulfan"@en-US ;
        dc:description  "mixture, InChIKey RDYMFSUJUZBWLH-AZVNHNRSSA-N"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000102>
        rdf:type        owl:Class ;
        rdfs:label      "Hazard Assessment"@en-US ;
        dc:description  "The process of assessing the intrinsic hazard a substance poses to human health and/or the environment. This provides information on potential human health effects such that a safe production and use of a chemical can be assured. Two types can be generally distinguished, i.e. with the purpose to classify the chemical to a certain category of toxicity (mostly qualitative assessment) or to derive an exposure limit, such as a health-based guidance value or product limit, that ensures safe use."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000409>
        rdf:type        owl:Class ;
        rdfs:label      "Organisation for Economic Co-operation and Development"@en-US ;
        ncit:C42610     "OECD"@en-US ;
        dc:description  "Intergovernmental economic organization"@en-US .

<https://vhp4safety.github.io/glossary#Q1881>
        rdf:type        owl:Class ;
        rdfs:label      "silychristin A"@en-US ;
        dc:description  "chemical compound, InChIKey BMLIIPOXVWESJG-LMBCONBSSA-N, CAS registry number 33889-69-9"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000385>
        rdf:type        owl:Class ;
        rdfs:label      "National Institute for Public Health and the Environment"@en-US ;
        ncit:C42610     "RIVM"@en-US ;
        dc:description  "Dutch research institute"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000174>
        rdf:type        owl:Class ;
        rdfs:label      "Toxicodynamics"@en-US ;
        ncit:C42610     "TD"@en-US ;
        dc:description  "Study of interactions between the toxicant and a biological target"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000089>
        rdf:type        owl:Class ;
        rdfs:label      "Bioactivity"@en-US ;
        dc:description  "The affinity and/or potency of a compound for a protein target."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000355>
        rdf:type    owl:Class ;
        rdfs:label  "qAOP-App"@en-US .

<https://vhp4safety.github.io/glossary#Q5071>
        rdf:type        owl:Class ;
        rdfs:label      "cisplatin"@en-US ;
        dc:description  "pharmaceutical drug, InChIKey LXZZYRPGZAFOLE-UHFFFAOYSA-L, CAS registry number 15663-27-1"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000144>
        rdf:type        owl:Class ;
        rdfs:label      "Interability"@en-US ;
        dc:description  "The ability to explain or to present a model, such as Large Language Models and machine learning systems in understandable terms to a human."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000410>
        rdf:type        owl:Class ;
        rdfs:label      "World Health Organization"@en-US ;
        ncit:C42610     "WHO"@en-US ;
        dc:description  "United Nations agency concerned with international public health"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000059>
        rdf:type             owl:Class ;
        rdfs:label           "Physiologically based pharmacokinetic model"@en-US ;
        ncit:C42610          "PBPK"@en-US ;
        dc:description       "Mechanistic representation of ADME processes for a chemical in a living organism, based on physiological and chemical properties"@en-US ;
        owl:equivalentClass  <https://vhp4safety.github.io/glossary#VHP0000060> , <https://vhp4safety.github.io/glossary#VHP0000062> , <https://vhp4safety.github.io/glossary#VHP0000061> .

<https://vhp4safety.github.io/glossary#VHP0000325>
        rdf:type    owl:Class ;
        rdfs:label  "BioTransformer"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000114>
        rdf:type        owl:Class ;
        rdfs:label      "Incident Postmortem"@en-US ;
        dc:description  "A framework for learning from incidents and turning problems into progress by bringing people together to discuss the details of the incident to explore why it happened, its impact, the actions that can be taken to mitigate and resolve it, and the actions to prevent it happen again."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000029>
        rdf:type        owl:Class ;
        rdfs:label      "Molecular Adverse Outcome Pathways"@en-US ;
        ncit:C42610     "mAOP"@en-US ;
        dc:description  "Metapathway, similar to conventional AOPs, but connected events as e.g. WikiPathways pathways. Their function is to expand KEs with molecular pathways and allow analyses of omics data."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000090>
        rdf:type        owl:Class ;
        rdfs:label      "Proteochemometric"@en-US ;
        ncit:C42610     "PCM"@en-US ;
        dc:description  "Mathematical models that can be used to predict the biological properties (mainly bioactivity) of compounds on proteins from the knowledge of their (chemical) structure."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000397>
        rdf:type        owl:Class ;
        rdfs:label      "Unilever"@en-US ;
        dc:description  "British multinational consumer goods company"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000271>
        rdf:type        owl:Class ;
        rdfs:label      "Recommended Daily Intake"@en-US ;
        ncit:C42610     "RDI"@en-US ;
        dc:description  "The amounts of various substances in the diet recommended by governmental guidelines as needed to sustain healthy life."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000186>
        rdf:type        owl:Class ;
        rdfs:label      "Thyroid Hormone"@en-US ;
        ncit:C42610     "TH"@en-US ;
        dc:description  "Any of several closely related compounds that are produced by the thyroid gland and are active metabolically."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000060>
        rdf:type             owl:Class ;
        rdfs:label           "Physiologically based toxicokinetic model"@en-US ;
        ncit:C42610          "PBTK"@en-US ;
        dc:description       "See PBPK model (these terms are equivalent)"@en-US ;
        owl:equivalentClass  <https://vhp4safety.github.io/glossary#VHP0000059> .

<https://vhp4safety.github.io/glossary#VHP0000367>
        rdf:type    owl:Class ;
        rdfs:label  "PROAST"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000241>
        rdf:type    owl:Class ;
        rdfs:label  "CellTiter-Glo assay"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000156>
        rdf:type        owl:Class ;
        rdfs:label      "Toxicodynamics (Process Flow Step)"@en-US ;
        dc:description  "A process flow step that is named after Toxicodynamics and categorizes services that use or extend the (quantitative) AOP framework to analyze and assess the interaction of chemicals with biological targets."@en-US ;
        dct:relation    <https://vhp4safety.github.io/glossary#VHP0000102> .

<https://vhp4safety.github.io/glossary#VHP0000030>
        rdf:type        owl:Class ;
        rdfs:label      "TXG-MAPr R package"@en-US ;
        ncit:C42610     "TXG-MAPr"@en-US ;
        dc:description  "Statistical quantitative AOP approach using known coexpression changes in tissue toxicity."@en-US .

<https://vhp4safety.github.io/glossary#Q4921>
        rdf:type        owl:Class ;
        rdfs:label      "tacrolimus"@en-US ;
        dc:description  "immunosuppressive Rx drug, InChIKey QJJXYPPXXYFBGM-LFZNUXCKSA-N, CAS registry number 104987-11-3"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000337>
        rdf:type    owl:Class ;
        rdfs:label  "FAIRDOMHub"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000211>
        rdf:type        owl:Class ;
        rdfs:label      "Organ-on-a-chip"@en-US ;
        dc:description  "Devices designed to recapitulate tissue or organ-level physiology and architect by combining MICROFLUIDICS; MICROFABRICATION; and 3D CELL CULTURE. Microphysiological systems mimic interconnections important in physiological or pathophysiological states of organ(s) and are often used for instance in HIGH THROUGHPUT SCREENING of drugs and factors important in disease modeling."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000126>
        rdf:type        owl:Class ;
        rdfs:label      "Sprint Review"@en-US ;
        dc:description  "A meeting at the end of a sprint where the team presents their work and discuss any issues. The goal is to review the completed tasks and adapt the backlog accordingly. This meeting can be combined with the Sprint Retrospective."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000307>
        rdf:type        owl:Class ;
        rdfs:label      "Ontology for Biomedical Investigations"@en-US ;
        ncit:C42610     "OBI"@en-US ;
        dc:description  "An ontology that provides terms with precisely defined meanings to describe all aspects of how investigations in the biological and medical domains are conducted."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000283>
        rdf:type        owl:Class ;
        rdfs:label      "SPARQL"@en-US ;
        dc:description  "SPARQL (SPARQL Protocol and RDF Query Language) is a semantic query language for querying and manipulating data stored in Resource Description Framework (RDF) format."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000198>
        rdf:type        owl:Class ;
        rdfs:label      "Neurodegeneration"@en-US ;
        dc:description  "Progressive loss of neural cells and tissue."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000072>
        rdf:type        owl:Class ;
        rdfs:label      "Work Package 2.2"@en-US ;
        ncit:C42610     "WP2.2"@en-US ;
        dc:description  "Disease state - Case study chronic kidney disease: objectives to identify critical physiological pathways, develop AOP networks, test toxicity of selected drugs, and assess the safety of selected drugs."@en-US .

<https://vhp4safety.github.io/glossary#VHP0000379>
        rdf:type    owl:Class ;
        rdfs:label  "NFDI Terminology Service"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000253>
        rdf:type    owl:Class ;
        rdfs:label  "Tissue-blood partition coefficient"@en-US .

<https://vhp4safety.github.io/glossary#Q4752>
        rdf:type        owl:Class ;
        rdfs:label      "monobutyl phthalate"@en-US ;
        ncit:C42610     "MBP"@en-US ;
        dc:description  "type of a chemical entity, InChIKey YZBOVSFWWNVKRJ-UHFFFAOYSA-N, CAS registry number 131-70-4"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000168>
        rdf:type        owl:Class ;
        rdfs:label      "immunosuppressant"@en-US ;
        dc:description  "agent that suppresses immune function by one of several mechanisms of action (e.g. inhibiting DNA synthesis, inhibiting activation of T-cells, or inhibiting the activation of helper cells)"@en-US .

<https://vhp4safety.github.io/glossary#VHP0000042>
        rdf:type        owl:Class ;
        rdfs:label      "Data stewardship"@en-US ;
        dc:description  "The work performed by a data steward."@en-US .

<https://vhp4safety.github.io/glossary#Q37>
        rdf:type        owl:Class ;
        rdfs:label      "rifampicin"@en-US ;
        dc:description  "pharmaceutical drug, InChIKey JQXXHWHPUNPDRT-WLSIYKJHSA-N, CAS registry number 13292-46-1"@en-US .

<https://vhp4safety.github.io/glossary#Q2062>
        rdf:type        owl:Class ;
        rdfs:label      "Silibinin"@en-US ;
        dc:description  "mixture"@en-US .

