        ncit:C42610     "REACH"@en-US ;
        dc:description  "Regulation (EC) No 1907/2006 of the European Parliament and of the Council concerning the Registration, Evaluation, Authorization and Restriction of Chemicals (REACH)."@en-US .

<https://vhp4safety.github.io/glossary#Q17>
        rdf:type        owl:Class ;
